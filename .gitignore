# https://dart.dev/guides/libraries/private-files
# Created by `dart pub`
.dart_tool/

# Avoid committing pubspec.lock for library packages; see
# https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock

# Generated documentation (regenerate with `dart doc`; never commit).
# Excluded from the published archive by .pubignore as well, since
# .pubignore overrides .gitignore per directory.
doc/
doc_warnings.txt

# Build artifacts
*.g.dart
*.generated.dart

# NOTE: tool/ is intentionally NOT ignored. tool/audit_probe.dart is the
# audit regression harness and is executed by CI, so it must be tracked.
# It is kept out of the published package via .pubignore instead.
